{
  "name": "pravda",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PRAVDA — documentary articles in timeline, graph, and catalog views.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:data": "node scripts/generate-public-articles.mjs",
    "check:generated": "node scripts/generate-public-articles.mjs --check",
    "build": "npm run verify:data && tsc --noEmit -p tsconfig.app.json && vite build && npm run verify:dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:data": "npm run check:generated && node scripts/verify-data.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
